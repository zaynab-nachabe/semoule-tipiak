// Schéma de la base (PostgreSQL). Contextes "Profile & Consent Management" (personnes, relations
// consenties, configuration) et historique (alertes et signaux, alimentés par les événements MQTT).
// Première version : lot B1 (Anaïs Lacouture) ; alignée ensuite sur le contrat d'événements.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Énumérations (alignées sur packages/shared-types)
// ─────────────────────────────────────────────────────────────

/// Rôle principal d'un compte. SENIOR = personne suivie,
/// FAMILY = proche, MEDICAL = équipe soignante.
enum Role {
  SENIOR
  FAMILY
  MEDICAL
}

/// Cycle de vie du consentement d'une relation de suivi.
/// Le consentement doit être prouvable, traçable et révocable (RGPD).
enum ConsentStatus {
  PENDING // demandé, pas encore accordé
  GRANTED // accordé, relation active
  REVOKED // retiré, relation inactive
}

enum AlertReason {
  FALL_DETECTED
  PROLONGED_INACTIVITY
  HELP_REQUESTED
}

enum AlertStatus {
  PENDING
  PRE_CONFIRMING
  ESCALATED
  RESOLVED
}

/// Échelle de gravité à 4 niveaux (ADR 0005).
enum Severity {
  SYSTEM
  PRE_ALERT
  WARNING
  CRITICAL
}

enum EscalationCause {
  NO_RESPONSE
  SENIOR_CONFIRMED
  IMMEDIATE
  NO_RECOVERY
  NO_HEART_SIGNAL
}

enum CancellationCause {
  SENIOR_CANCELED
  ACTIVITY_RESUMED
}

enum SignalType {
  PIR_MOTION
  PRESSURE_PLATE
  HEART_RATE
  FALL_IMPACT
  HELP_BUTTON
  CANCEL_ALERT
  SENSOR_HEARTBEAT
}

// ─────────────────────────────────────────────────────────────
// Comptes et personnes
// ─────────────────────────────────────────────────────────────

/// Un compte utilisateur. Connexion par simple choix dans la liste des comptes
/// (l'authentification est hors du périmètre du sujet) : pas de mot de passe.
model Person {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String
  role      Role
  createdAt DateTime @default(now())

  // Si cette personne est un senior suivi, le profil correspondant.
  seniorProfile Senior?

  // Relations de suivi où cette personne est l'aidant/soignant.
  caringRelationships CareRelationship[] @relation("Caregiver")

  // Notifications reçues (boîte de réception).
  notifications Notification[]

  @@map("persons")
}

/// Profil d'un senior suivi. Un Senior EST une Person (1-1), enrichie des données de suivi.
/// Son id est le seniorId des événements (ex. "senior-001"), donc compatible avec les topics MQTT.
model Senior {
  id        String   @id @default(uuid())
  personId  String   @unique
  person    Person   @relation(fields: [personId], references: [id])
  createdAt DateTime @default(now())
  /// Fuseau horaire IANA du logement : les plages des seuils d'inactivité sont en heure locale (ADR 0010).
  timeZone  String   @default("Europe/Paris")

  // Qui suit ce senior (familles, soignants) via des relations consenties.
  relationships CareRelationship[]   @relation("TrackedSenior")
  thresholds    ToleranceThreshold[]
  absences      Absence[]
  sensors       Sensor[]
  contacts      EmergencyContact[]
  alerts        Alert[]
  signals       SignalRecord[]

  @@map("seniors")
}

// ─────────────────────────────────────────────────────────────
// Relation de suivi avec consentement (la table pivot)
// ─────────────────────────────────────────────────────────────

/// Lie un aidant/soignant (Person) à un Senior suivi. Porte le consentement et son cycle de vie.
/// C'est sur cette table que repose le double verrou d'autorisation (rôle × relation active consentie).
model CareRelationship {
  id String @id @default(uuid())

  seniorId String
  senior   Senior @relation("TrackedSenior", fields: [seniorId], references: [id])

  caregiverId String
  caregiver   Person @relation("Caregiver", fields: [caregiverId], references: [id])

  // Nature du lien : un proche (FAMILY) ou un soignant (MEDICAL).
  relationType Role

  // Consentement : état, horodatages, auteur de la demande.
  consentStatus ConsentStatus @default(PENDING)
  consentedAt   DateTime?
  revokedAt     DateTime?
  createdBy     String // id de la personne qui a initié le lien (traçabilité)

  createdAt DateTime @default(now())

  // Un même couple (senior, aidant) n'a qu'une relation.
  @@unique([seniorId, caregiverId])
  @@map("care_relationships")
}

// ─────────────────────────────────────────────────────────────
// Configuration de détection (éditée par le médical)
// ─────────────────────────────────────────────────────────────

/// Seuil de tolérance configuré pour un senior.
model ToleranceThreshold {
  id       String @id @default(uuid())
  seniorId String
  senior   Senior @relation(fields: [seniorId], references: [id])

  condition         String // "MAX_INACTIVITY_MINUTES", seule condition gérée
  durationInMinutes Int
  /// Plage horaire en heure locale "HH:MM" (les deux ou aucune) ; elle peut passer minuit. Sans plage : seuil par défaut.
  /// Le niveau de l'alerte n'est pas porté par le seuil : il dépend de la fréquence cardiaque (ADR 0010).
  startTime         String?
  endTime           String?

  @@map("tolerance_thresholds")
}

/// Contact d'urgence d'un senior.
model EmergencyContact {
  id       String @id @default(uuid())
  seniorId String
  senior   Senior @relation(fields: [seniorId], references: [id])

  fullName String
  phone    String
  priority Int    @default(1) // ordre d'appel

  @@map("emergency_contacts")
}

// ─────────────────────────────────────────────────────────────
// Historique, alimenté par les événements MQTT
// ─────────────────────────────────────────────────────────────

/// Journal des alertes : projection des événements de domaine publiés par la détection
/// (alerts/{seniorId}/{eventType}). L'id est l'alertId de la détection.
model Alert {
  id       String @id
  seniorId String
  senior   Senior @relation(fields: [seniorId], references: [id])

  reason             AlertReason
  status             AlertStatus
  severity           Severity? // null tant que non escaladée
  escalationCause    EscalationCause?
  cancellationCause  CancellationCause?
  triggeringEventIds String[]           @default([])
  createdAt          DateTime
  updatedAt          DateTime           @updatedAt
  acknowledgedAt     DateTime? // renseigné quand le médical prend en charge
  acknowledgedById   String? // personne qui a pris en charge (traçabilité)
  resolvedAt         DateTime?
  closedAt           DateTime? // clôture par le médical après intervention (alerte escaladée)
  closedById         String? // personne qui a clôturé (traçabilité)

  @@index([seniorId, createdAt])
  @@map("alerts")
}

enum NotificationPriority {
  INFO
  NORMAL
  URGENT
}

/// Notifications remises aux personnes (boîte de réception de l'application). Le service de notification
/// publie une notification par rôle (notifications/{seniorId}) ; l'API la remet à chaque personne de ce rôle
/// ayant une relation consentie avec le senior. Un doublon (même eventId pour la même personne) est ignoré.
model Notification {
  id              String               @id @default(uuid())
  eventId         String // eventId de la notification publiée (dédoublonnage)
  recipientId     String
  recipient       Person               @relation(fields: [recipientId], references: [id])
  seniorId        String
  /// Une notification concerne une alerte (alertId, reason, escalationCause) ou un capteur (sensorId) : ADR 0012.
  alertId         String?
  sensorId        String?
  priority        NotificationPriority
  severity        Severity
  reason          AlertReason?
  escalationCause EscalationCause?
  title           String
  message         String
  createdAt       DateTime
  readAt          DateTime?

  @@unique([eventId, recipientId])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

/// Historique des signaux normalisés (signals/{seniorId}/{type}). L'eventId sert de clé :
/// un signal reçu deux fois (QoS 1) n'est enregistré qu'une fois.
model SignalRecord {
  eventId    String     @id
  seniorId   String
  senior     Senior     @relation(fields: [seniorId], references: [id])
  sensorId   String
  type       SignalType
  timestamp  DateTime
  payload    Json
  receivedAt DateTime   @default(now())

  @@index([seniorId, type, timestamp])
  @@map("signals")
}

// ─────────────────────────────────────────────────────────────
// Absence déclarée par le senior (« je m'absente », ADR 0011)
// ─────────────────────────────────────────────────────────────

/// Pourquoi une absence s'est terminée avant le retour prévu (null : elle court, ou s'est terminée à l'heure prévue).
enum AbsenceEnd {
  RETURNED          // « je suis rentré(e) »
  ACTIVITY_AT_HOME  // mouvement au domicile plus de 15 min après le départ
  REPLACED          // nouvelle absence déclarée
}

/// Pendant une absence, l'inactivité n'est pas surveillée (la chute et l'aide le restent).
model Absence {
  id               String      @id @default(uuid())
  seniorId         String
  senior           Senior      @relation(fields: [seniorId], references: [id])
  startedAt        DateTime    @default(now())
  /// Retour prévu, au plus 24 h après le départ ; l'absence se termine seule à cette heure.
  expectedReturnAt DateTime
  endedAt          DateTime?
  endReason        AbsenceEnd?

  @@index([seniorId, startedAt])
  @@map("absences")
}

// ─────────────────────────────────────────────────────────────
// Registre des capteurs attendus et leur état (ADR 0012)
// ─────────────────────────────────────────────────────────────

enum SensorKind {
  PIR
  PRESSURE_PLATE
  WATCH
}

enum SensorStatus {
  ONLINE
  OFFLINE
  LOW_BATTERY
}

/// Capteur attendu chez un senior. L'identifiant est le sensorId des signaux (friendly_name dans Zigbee2MQTT).
/// Copie du registre de Node-RED (limite connue : deux registres à tenir à jour, ADR 0012).
model Sensor {
  id                      String       @id
  seniorId                String
  senior                  Senior       @relation(fields: [seniorId], references: [id])
  kind                    SensorKind
  model                   String?
  room                    String?
  location                String?
  /// Au-delà de ce délai sans signal, la détection déclare le capteur muet.
  expectedIntervalMinutes Int
  /// Dernier état publié par la détection (SensorStatusChanged).
  status                  SensorStatus @default(ONLINE)
  statusChangedAt         DateTime?

  @@index([seniorId])
  @@map("sensors")
}

