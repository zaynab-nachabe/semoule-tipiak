{
  "name": "@project/shared-types",
  "version": "1.0.0",
  "private": true,
  "description": "Contrat de données partagé : types TypeScript, JSON Schemas et noms de topics MQTT (voir docs/format-evenements.md)",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "typescript": "^5.6.0"
  }
}
