// Compilation en JavaScript (CommonJS) pour les services qui chargent le package à l'exécution
// sans le regrouper (l'API NestJS). Les types restent lus directement depuis src/.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src"]
}
