# Facultatif : le projet démarre sans fichier .env (docker compose up --build -d).
# Copier ce fichier en .env seulement pour changer une valeur ; une ligne vide garde la valeur par défaut.

# Identifiants de la base (défaut : maintien_domicile / app / change-me ; à changer pour un vrai déploiement)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Détection : délais raccourcis par défaut pour la démonstration.
# Pour retrouver les valeurs des ADR (vrai déploiement) :
#   PRE_CONFIRMATION_DELAY_S=60  RECOVERY_WINDOW_S=90  CRITICAL_ESCALATION_DELAY_S=300
#   INACTIVITY_CHECK_INTERVAL_S=60  SENSOR_CHECK_INTERVAL_S=60  ABSENCE_GRACE_S=900
PRE_CONFIRMATION_DELAY_S=
RECOVERY_WINDOW_S=
CRITICAL_ESCALATION_DELAY_S=
# Inactivité : fréquence de vérification des seuils (défaut 10 s) et validité d'une fréquence cardiaque (défaut 600 s)
INACTIVITY_CHECK_INTERVAL_S=
HEART_RATE_FRESHNESS_S=
# Capteurs : vérification des capteurs muets (défaut 10 s) et seuil de batterie faible (défaut 20 %)
SENSOR_CHECK_INTERVAL_S=
LOW_BATTERY_PERCENT=
# Absence : délai après le départ au-delà duquel un mouvement au domicile la termine (défaut 30 s)
ABSENCE_GRACE_S=

# API : secret de signature des jetons (défaut : valeur de développement)
JWT_SECRET=
# Clé partagée entre la détection et l'API pour lire les profils d'activité (défaut : valeur de développement)
SERVICE_TOKEN=

# Port de l'application web sur la machine (défaut 8080 ; à changer s'il est déjà pris)
WEB_PORT=
