# Identifiants de la base (valeurs de démonstration ; à changer pour un vrai déploiement)
POSTGRES_DB=maintien_domicile
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# Détection : délais raccourcis pour une démonstration (laisser vide = valeurs des ADR : 60 s, 90 s, 300 s)
PRE_CONFIRMATION_DELAY_S=
RECOVERY_WINDOW_S=
CRITICAL_ESCALATION_DELAY_S=
# Inactivité : fréquence de vérification des seuils (vide = 60 s) et validité d'une fréquence cardiaque (vide = 600 s)
INACTIVITY_CHECK_INTERVAL_S=
HEART_RATE_FRESHNESS_S=
# Capteurs : vérification des capteurs muets (vide = 60 s) et seuil de batterie faible (vide = 20 %)
SENSOR_CHECK_INTERVAL_S=
LOW_BATTERY_PERCENT=
# Absence : délai de départ après lequel un mouvement au domicile la termine (vide = 900 s)
ABSENCE_GRACE_S=

# API : secret de signature des jetons (laisser vide = valeur de développement)
JWT_SECRET=
# Clé partagée entre la détection et l'API pour lire les seuils d'inactivité (vide = valeur de développement)
SERVICE_TOKEN=

# Ports sur la machine (laisser vide = 8080 et 5432 ; à changer s'ils sont déjà pris)
WEB_PORT=
POSTGRES_PORT=
