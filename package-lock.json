{
  "name": "semoule-tipiak",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "semoule-tipiak",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "apps/*",
        "services/detection",
        "services/notification"
